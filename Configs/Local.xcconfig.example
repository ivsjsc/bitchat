// Copy this file to Configs/Local.xcconfig (ignored by git) for local device builds.
// Apple Developer Team ID: https://developer.apple.com/account
DEVELOPMENT_TEAM = YOUR_TEAM_ID

// Defaults are already IVS-specific in Release.xcconfig.
// Override only if your Apple Developer account requires a different identifier.
PRODUCT_BUNDLE_IDENTIFIER = com.ivsjsc.bitchat
APP_GROUP_ID = group.com.ivsjsc.bitchat
APP_DISPLAY_NAME = Bitchat IVS
